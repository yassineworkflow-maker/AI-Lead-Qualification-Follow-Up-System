              "name": "Authorization",
              "value": "Bearer YOUR_OPENAI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-5.6\",\n  \"input\": \"أنت مسؤول تأهيل العملاء المحتملين في وكالة تسويق رقمي.\\n\\nحلل بيانات العميل التالية وحدد مدى احتمالية تحوله إلى عميل حقيقي.\\n\\nالاسم: {{ $json.name }}\\nالبريد الإلكتروني: {{ $json.email }}\\nالخدمة المطلوبة: {{ $json.service }}\\nالميزانية: {{ $json.budget }}\\nرسالة العميل: {{ $json.message }}\\n\\nأعطني النتيجة بهذا الشكل:\\nLead Score: رقم من 0 إلى 100\\nPriority: HOT أو WARM أو COLD\\nReason: سبب مختصر للقرار\"\n}",
        "options": {}
      },
