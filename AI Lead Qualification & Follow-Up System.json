    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      name: \"Ahmed\",\n      email: \"ahmed@example.com\",\n      service: \"E-commerce Website\",\n      budget: 10000,\n      message: \"أريد إنشاء متجر إلكتروني لشركتي وأريد البدء خلال أسبوعين، وأحتاج نظام دفع وربط مع CRM.\"\n    }\n  },\n  {\n    json: {\n      name: \"Youssef\",\n      email: \"youssef@example.com\",\n      service: \"E-commerce Website\",\n      budget: 300,\n      message: \"كم سعر إنشاء متجر؟ أنا فقط أستفسر عن الأسعار حاليًا.\"\n    }\n  },\n  {\n    json: {\n      name: \"Sara\",\n      email: \"sara@example.com\",\n      service: \"AI Automation\",\n      budget: 4000,\n      message: \"لدينا شركة ونريد أتمتة معالجة العملاء المحتملين ونريد البدء هذا الشهر.\"\n    }\n  },\n  {\n    json: {\n      name: \"Omar\",\n      email: \"omar@example.com\",\n      service: \"Website\",\n      budget: 1500,\n      message: \"أحتاج موقعًا ولكن ربما أبدأ بعد 6 أشهر، ما زلت أقارن بين الشركات.\"\n    }\n  },\n  {\n    json: {\n      name: \"Karim\",\n      email: \"karim@example.com\",\n      service: \"CRM Automation\",\n      budget: 7000,\n      message: \"لدينا أكثر من 1000 عميل ونريد أتمتة المتابعة مع العملاء. نحتاج الحل في أقرب وقت.\"\n    }\n  },\n  {\n    json: {\n      name: \"Adam\",\n      email: \"adam@example.com\",\n      service: \"Chatbot\",\n      budget: 50,\n      message: \"أريد معرفة تكلفة chatbot فقط، ليس لدي مشروع محدد حاليًا.\"\n    }\n  },\n  {\n    json: {\n      name: \"Hassan\",\n      email: \"hassan@example.com\",\n      service: \"AI Automation\",\n      budget: 3500,\n      message: \"لدينا مشكلة في متابعة الـleads ونفقد الكثير منها. نريد حلًا عمليًا ونستطيع البدء الأسبوع القادم.\"\n    }\n  },\n   {\n    json: {\n      name: \"Mehdi\",\n      email: \"mehdi@example.com\",\n      service: \"Website\",\n      budget: 6000,\n      message: \"أريد موقعًا لشركتي لكن القرار النهائي سيكون السنة القادمة.\"\n    }\n  },\n  {\n    json: {\n      name: \"Nadia\",\n      email: \"nadia@example.com\",\n      service: \"Lead Generation\",\n      budget: 4500,\n      message: \"نريد زيادة عدد العملاء المحتملين ونحتاج إلى البدء فورًا. هل يمكن تحديد موعد لمناقشة المشروع؟\"\n    }\n  },\n  {\n    json: {\n      name: \"Samir\",\n      email: \"samir@example.com\",\n      service: \"Automation\",\n      budget: 100,\n      message: \"هل يمكنكم إعطائي فكرة عن الخدمات التي تقدمونها؟ لا أعرف بعد ما أحتاجه.\"\n    }\n  }\n];"
